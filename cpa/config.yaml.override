remote-management:
  allow-remote: true
  secret-key: ${CPA_MANAGEMENT_KEY:?CPA_MANAGEMENT_KEY must be set}

auth-dir: "/CLIProxyAPI/.cli-proxy-api"

usage-statistics-enabled: true

api-keys:
  - ${CPA_CLIENT_API_KEY_1:?CPA_CLIENT_API_KEY_1 must be set}
  - ${CPA_CLIENT_API_KEY_2:?CPA_CLIENT_API_KEY_2 must be set}
  - ${CPA_CLIENT_API_KEY_3:?CPA_CLIENT_API_KEY_3 must be set}
