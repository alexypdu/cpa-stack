{
  "name": "cpa-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "cpa-stack": "./bin/cpa-stack.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:compose": "node --test test/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings bin src test",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write 'bin/**/*.ts' 'src/**/*.ts' 'test/**/*.ts' package.json tsconfig.json",
    "format:check": "oxfmt --check 'bin/**/*.ts' 'src/**/*.ts' 'test/**/*.ts' package.json tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:compose",
    "prepare": "husky"
  },
  "lint-staged": {
    "{bin,src,test}/**/*.ts": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write"
    ],
    "./{package,tsconfig}.json": "oxfmt --write"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.9.3"
  }
}
