#!/bin/sh
set -eu
umask 077

script_dir=$(CDPATH='' cd -P "$(dirname "$0")" && pwd)
compose_file="$script_dir/docker-compose.yml"
baseline="$script_dir/cpa/config.yaml.example"
override="$script_dir/cpa/config.yaml.override"
effective="$script_dir/cpa/config.yaml"
backup="$script_dir/cpa/config.yaml.backup"
env_file="$script_dir/.env"

compose_input=
compose_output=
resolved_override=
staged_effective=
staged_backup=
cpa_release=
keeper_release=
staged_compose=
staged_baseline=
sync_compose_backup=
sync_baseline_backup=
sync_compose_replaced=0
sync_baseline_replaced=0

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM

  if [ "$status" -ne 0 ]; then
    if [ "$sync_baseline_replaced" -eq 1 ] && [ -e "$sync_baseline_backup" ]; then
      mv "$sync_baseline_backup" "$baseline" || status=1
      sync_baseline_backup=
    fi
    if [ "$sync_compose_replaced" -eq 1 ] && [ -e "$sync_compose_backup" ]; then
      mv "$sync_compose_backup" "$compose_file" || status=1
      sync_compose_backup=
    fi
  fi

  for path in \
    "$compose_input" \
    "$compose_output" \
    "$resolved_override" \
    "$staged_effective" \
    "$staged_backup" \
    "$cpa_release" \
    "$keeper_release" \
    "$staged_compose" \
    "$staged_baseline" \
    "$sync_compose_backup" \
    "$sync_baseline_backup"
  do
    if [ -n "$path" ] && [ -e "$path" ]; then
      rm -f "$path"
    fi
  done
  exit "$status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

fail() {
  printf 'cpa-stack: %s\n' "$*" >&2
  exit 1
}

require_file() {
  [ -f "$1" ] || fail "required file not found: $1"
}

require_yq() {
  command -v yq >/dev/null 2>&1 || fail "Mike Farah yq is required"
  yq_version=$(yq --version 2>&1) || fail "could not determine yq version; Mike Farah yq is required"
  case "$yq_version" in
    *mikefarah/yq*) ;;
    *) fail "incompatible yq implementation; Mike Farah yq is required" ;;
  esac
}

require_generate_tools() {
  command -v docker >/dev/null 2>&1 || fail "Docker with Compose is required"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose is required"
  require_yq
}

require_sync_tools() {
  command -v curl >/dev/null 2>&1 || fail "curl is required"
  command -v git >/dev/null 2>&1 || fail "Git is required"
  require_yq
}

check_sync_destinations() {
  conflicts=
  for path in docker-compose.yml cpa/config.yaml.example; do
    if ! git -C "$script_dir" diff --quiet -- "$path" ||
      ! git -C "$script_dir" diff --cached --quiet -- "$path"
    then
      if [ -n "$conflicts" ]; then
        conflicts="$conflicts, $path"
      else
        conflicts=$path
      fi
    fi
  done

  [ -z "$conflicts" ] || fail "refusing to overwrite pre-existing changes to: $conflicts"
}

download() {
  url=$1
  destination=$2
  description=$3

  curl -fsSL \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    -o "$destination" \
    "$url" || fail "could not download $description"
}

release_tag() {
  release_file=$1
  release_name=$2

  yq eval -e 'type == "!!map" and (.draft | type == "!!bool") and (.prerelease | type == "!!bool") and (.tag_name | type == "!!str")' "$release_file" >/dev/null 2>&1 || fail "$release_name release metadata is malformed"
  draft=$(yq eval -r '.draft' "$release_file") || fail "could not read $release_name release metadata"
  prerelease=$(yq eval -r '.prerelease' "$release_file") || fail "could not read $release_name release metadata"
  tag=$(yq eval -r '.tag_name' "$release_file") || fail "could not read $release_name release metadata"

  [ "$draft" = false ] || fail "$release_name latest release is a draft"
  [ "$prerelease" = false ] || fail "$release_name latest release is a prerelease"
  case "$tag" in
    ''|null|*[!A-Za-z0-9._-]*) fail "$release_name release metadata has an invalid tag" ;;
  esac

  printf '%s\n' "$tag"
}

validate_compose() {
  compose_path=$1
  expected_cpa_image=$2
  expected_keeper_image=$3

  yq eval '.' "$compose_path" >/dev/null 2>&1 || fail "docker-compose.yml is not valid YAML"
  actual_cpa_image=$(yq eval -r '.services."cli-proxy-api".image' "$compose_path") || fail "could not read the CPA image declaration"
  actual_keeper_image=$(yq eval -r '.services."cpa-usage-keeper".image' "$compose_path") || fail "could not read the Keeper image declaration"

  [ "$actual_cpa_image" = "$expected_cpa_image" ] || fail "docker-compose.yml has an unexpected CPA image declaration"
  [ "$actual_keeper_image" = "$expected_keeper_image" ] || fail "docker-compose.yml has an unexpected Keeper image declaration"
}

stage_compose() {
  cpa_tag=$1
  keeper_tag=$2

  awk -v cpa_tag="$cpa_tag" -v keeper_tag="$keeper_tag" '
    /^[[:space:]]*image:[[:space:]]*eceasy\/cli-proxy-api:[^[:space:]#]+/ {
      sub(/eceasy\/cli-proxy-api:[^[:space:]#]+/, "eceasy/cli-proxy-api:" cpa_tag)
      cpa_count++
    }
    /^[[:space:]]*image:[[:space:]]*ghcr\.io\/willxup\/cpa-usage-keeper:[^[:space:]#]+/ {
      sub(/ghcr\.io\/willxup\/cpa-usage-keeper:[^[:space:]#]+/, "ghcr.io/willxup/cpa-usage-keeper:" keeper_tag)
      keeper_count++
    }
    { print }
    END {
      if (cpa_count != 1 || keeper_count != 1) {
        exit 1
      }
    }
  ' "$compose_file" >"$staged_compose" || fail "could not update the expected image declarations"
}

sync() {
  require_sync_tools
  require_file "$compose_file"
  require_file "$baseline"
  check_sync_destinations

  current_cpa_image=$(yq eval -r '.services."cli-proxy-api".image' "$compose_file") || fail "could not read the CPA image declaration"
  current_keeper_image=$(yq eval -r '.services."cpa-usage-keeper".image' "$compose_file") || fail "could not read the Keeper image declaration"
  case "$current_cpa_image" in
    eceasy/cli-proxy-api:*) ;;
    *) fail "docker-compose.yml has an unexpected CPA image declaration" ;;
  esac
  case "$current_keeper_image" in
    ghcr.io/willxup/cpa-usage-keeper:*) ;;
    *) fail "docker-compose.yml has an unexpected Keeper image declaration" ;;
  esac
  validate_compose "$compose_file" "$current_cpa_image" "$current_keeper_image"

  cpa_release=$(mktemp "${TMPDIR:-/tmp}/cpa-stack.cpa-release.XXXXXX") || fail "could not create temporary CPA release metadata"
  keeper_release=$(mktemp "${TMPDIR:-/tmp}/cpa-stack.keeper-release.XXXXXX") || fail "could not create temporary Keeper release metadata"
  staged_compose=$(mktemp "$script_dir/.docker-compose.yml.XXXXXX") || fail "could not stage docker-compose.yml"
  staged_baseline=$(mktemp "$script_dir/cpa/.config.yaml.example.XXXXXX") || fail "could not stage the upstream baseline"

  download 'https://api.github.com/repos/router-for-me/CLIProxyAPI/releases/latest' "$cpa_release" 'CPA release metadata'
  download 'https://api.github.com/repos/Willxup/cpa-usage-keeper/releases/latest' "$keeper_release" 'Keeper release metadata'
  cpa_tag=$(release_tag "$cpa_release" CPA)
  keeper_tag=$(release_tag "$keeper_release" Keeper)

  download "https://raw.githubusercontent.com/router-for-me/CLIProxyAPI/$cpa_tag/config.example.yaml" "$staged_baseline" "the CPA $cpa_tag upstream baseline"
  [ -s "$staged_baseline" ] || fail "the CPA $cpa_tag upstream baseline is empty"
  yq eval -e 'type == "!!map"' "$staged_baseline" >/dev/null 2>&1 || fail "the CPA $cpa_tag upstream baseline is not a valid YAML mapping"

  stage_compose "$cpa_tag" "$keeper_tag"
  chmod 644 "$staged_compose" "$staged_baseline" || fail "could not set tracked artifact permissions"

  expected_cpa_image="eceasy/cli-proxy-api:$cpa_tag"
  expected_keeper_image="ghcr.io/willxup/cpa-usage-keeper:$keeper_tag"
  validate_compose "$staged_compose" "$expected_cpa_image" "$expected_keeper_image"

  cpa_changed=0
  keeper_changed=0
  compose_changed=0
  baseline_changed=0
  [ "$current_cpa_image" = "$expected_cpa_image" ] || cpa_changed=1
  [ "$current_keeper_image" = "$expected_keeper_image" ] || keeper_changed=1
  [ "$cpa_changed" -eq 0 ] && [ "$keeper_changed" -eq 0 ] || compose_changed=1
  cmp -s "$baseline" "$staged_baseline" || baseline_changed=1

  check_sync_destinations

  if [ "$compose_changed" -eq 1 ]; then
    sync_compose_backup=$(mktemp "$script_dir/.docker-compose.yml.backup.XXXXXX") || fail "could not stage the Compose rollback copy"
    cp -p "$compose_file" "$sync_compose_backup" || fail "could not copy docker-compose.yml for rollback"
  fi
  if [ "$baseline_changed" -eq 1 ]; then
    sync_baseline_backup=$(mktemp "$script_dir/cpa/.config.yaml.example.backup.XXXXXX") || fail "could not stage the baseline rollback copy"
    cp -p "$baseline" "$sync_baseline_backup" || fail "could not copy the upstream baseline for rollback"
  fi

  if [ "$compose_changed" -eq 1 ]; then
    sync_compose_replaced=1
    mv "$staged_compose" "$compose_file" || fail "could not replace docker-compose.yml"
    staged_compose=
  fi
  if [ "$baseline_changed" -eq 1 ]; then
    sync_baseline_replaced=1
    mv "$staged_baseline" "$baseline" || fail "could not replace the upstream baseline"
    staged_baseline=
  fi

  if [ "$cpa_changed" -eq 1 ]; then
    printf 'CPA: selected %s (updated).\n' "$cpa_tag"
  else
    printf 'CPA: selected %s (unchanged).\n' "$cpa_tag"
  fi
  if [ "$keeper_changed" -eq 1 ]; then
    printf 'Keeper: selected %s (updated).\n' "$keeper_tag"
  else
    printf 'Keeper: selected %s (unchanged).\n' "$keeper_tag"
  fi
  if [ "$baseline_changed" -eq 1 ]; then
    printf 'Upstream baseline: updated cpa/config.yaml.example.\n'
  else
    printf 'Upstream baseline: unchanged.\n'
  fi
  if [ "$compose_changed" -eq 1 ]; then
    printf 'Tracked artifact changed: docker-compose.yml.\n'
  fi
  if [ "$baseline_changed" -eq 1 ]; then
    printf 'Tracked artifact changed: cpa/config.yaml.example.\n'
  fi

  sync_compose_replaced=0
  sync_baseline_replaced=0
}

generate() {
  require_generate_tools
  require_file "$baseline"
  require_file "$override"
  require_file "$env_file"

  compose_input=$(mktemp "${TMPDIR:-/tmp}/cpa-stack.compose.XXXXXX") || fail "could not create temporary Compose input"
  compose_output=$(mktemp "${TMPDIR:-/tmp}/cpa-stack.rendered.XXXXXX") || fail "could not create temporary Compose output"
  resolved_override=$(mktemp "${TMPDIR:-/tmp}/cpa-stack.override.XXXXXX") || fail "could not create temporary override"
  staged_effective=$(mktemp "$script_dir/cpa/.config.yaml.XXXXXX") || fail "could not stage effective configuration"

  yq eval '{"x-cpa-stack-override": .}' "$override" >"$compose_input" || fail "could not prepare the stack override"
  docker compose --env-file "$env_file" -f "$compose_input" config >"$compose_output" || fail "could not interpolate the stack override"
  yq eval '."x-cpa-stack-override"' "$compose_output" >"$resolved_override" || fail "could not extract the interpolated stack override"
  yq eval-all 'select(fileIndex == 0) * select(fileIndex == 1)' "$baseline" "$resolved_override" >"$staged_effective" || fail "could not merge the CPA configuration layers"
  chmod 600 "$staged_effective" || fail "could not secure the effective configuration"

  if [ -f "$effective" ]; then
    staged_backup=$(mktemp "$script_dir/cpa/.config.yaml.backup.XXXXXX") || fail "could not stage the configuration backup"
    cp "$effective" "$staged_backup" || fail "could not copy the existing configuration"
    chmod 600 "$staged_backup" || fail "could not secure the configuration backup"
    mv "$staged_backup" "$backup" || fail "could not preserve the existing configuration"
    staged_backup=
  fi

  mv "$staged_effective" "$effective" || fail "could not replace the effective configuration"
  staged_effective=

  printf 'Generated cpa/config.yaml with mode 0600.\n'
}

usage() {
  printf 'Usage: ./cpa-stack {sync|generate}\n' >&2
  exit 2
}

[ "$#" -eq 1 ] || usage

case "$1" in
  sync) sync ;;
  generate) generate ;;
  *) usage ;;
esac
